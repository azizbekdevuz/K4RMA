# K4RMA — Unity .gitignore
# Keep this file in the repository root.

# Unity-generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Unity Asset Store tools
[Aa]ssets/AssetStoreTools*

# Autogenerated Visual Studio / Rider files
.vs/
.vscode/
.idea/
.gradle/

*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.VC.opendb

# Unity-generated metadata
*.csproj.meta
*.sln.meta
*.slnx.meta
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports
sysinfo.txt

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary and backup files
*.tmp
*.temp
*.bak
*.orig
*.swp
*.swo
*~

# Unity test results
[Tt]est[Rr]esults/

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.keystore

# Keep Unity project settings, source code, assets,
# packages and .meta files under version control.